DATABASE_URL=postgres://user:password@host:5432/flexchat?sslmode=require
JWT_SECRET=replace-with-at-least-32-random-characters
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
CORS_ORIGIN=https://app.flexchat.example
FRONTEND_URL=https://app.flexchat.example
CLIENT_URL=https://app.flexchat.example
PUBLIC_API_URL=https://api.flexchat.example
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=https://api.flexchat.example/auth/google/callback
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
SOCKET_PING_INTERVAL_MS=18000
SOCKET_PING_TIMEOUT_MS=8000
SOCKET_CONNECT_TIMEOUT_MS=10000
SOCKET_UPGRADE_TIMEOUT_MS=20000
UPLOAD_RETENTION_HOURS=168
UPLOAD_CLEANUP_INTERVAL_MINUTES=60
TURNSTILE_SECRET_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Future TURN Configuration (Oracle VM)
TURN_SERVER_URLS=
TURN_AUTH_SECRET=

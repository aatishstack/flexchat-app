{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,

    "typeRoots": [
      "./node_modules/@types",
      "./src/types"
    ]
  },

  "exclude": [
    "dist",
    "node_modules"
  ]
}
"use client";

import { useRouter } from "next/navigation";

import {
  useEffect,
  ReactNode,
} from "react";

interface Props {
  children: ReactNode;
}

export const ProtectedRoute = ({
  children,
}: Props) => {
  const router = useRouter();

  useEffect(() => {
    const token =
      localStorage.getItem(
        "token"
      );

    if (!token) {
      router.push("/auth");
    }
  }, [router]);

  return children;
};